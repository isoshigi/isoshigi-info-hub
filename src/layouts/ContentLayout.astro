---
import BaseLayout from './BaseLayout.astro';
import SummaryCard from '../components/ui/SummaryCard.astro';
import PageFooter from '../components/ui/PageFooter.astro';
import type { ContentEntry } from '../lib/contents';
import type { ContentType } from '../lib/types';

interface Props {
  entry: ContentEntry['entry'];
  type: ContentType;
  contentClass?: string;
}

const { entry, type, contentClass = 'prose' } = Astro.props;
const { title, description, ...cardData } = entry.data;
---

<BaseLayout
  title={title}
  description={description}
  ogImage={`/img/${type}s/${entry.id}/og.png`}
  ogType="article"
>
  <article class="stack-section">
    <slot name="before-content" />
    <SummaryCard type={type} title={title} description={description} {...cardData} />
    <div class={contentClass}>
      <slot />
    </div>
    <PageFooter />
  </article>
</BaseLayout>
