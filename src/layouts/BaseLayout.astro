---
import '../styles/global.css';
import ShareButton from '../components/display/ShareButton.astro';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description,
  ogImage = '/img/og.png',
  ogType = 'website',
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const ogImageURL = new URL(ogImage, Astro.site || Astro.url.origin);
const fullTitle = title === 'いそしぎ忘備録' ? title : `${title} | いそしぎ忘備録`;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <title>{fullTitle}</title>

  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />

  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageURL} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="いそしぎ忘備録" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=M+PLUS+1+Code:wght@400;700&display=swap" rel="stylesheet" />
</head>
<body class="min-h-screen flex flex-col bg-bg">
  <header class="bg-header border-b-4 border-accent">
    <div class="container-page py-item flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-header-fg">
        いそしぎ忘備録
      </a>
      <nav class="flex items-center gap-tight">
        <a href="/" class="text-sm font-medium text-header-fg transition-colors">Home</a>
        <a href="/pages" class="text-sm font-medium text-header-fg transition-colors">すべての記録</a>

      </nav>
    </div>
  </header>

  <div class="flex-1 container-page w-full py-section page-grid">
    <main class="page-main"><slot /></main>
    <aside class="page-aside">
      <div class="card">
        <h3 class="text-sm font-bold text-text mb-tight">このページをシェア</h3>
        <ShareButton
          url={canonicalURL.toString()}
          title={title}
          description={description}
        />
      </div>
      <div class="card">
        <h3 class="text-sm font-bold text-text mb-tight">いそしぎのプロフィール</h3>
        <p class="text-sm text-text-muted mb-item">28卒の専門学生。技術的なアウトプットを小さく継続していくことを目指しています。</p>
        <p class="text-sm text-text-muted mb-item">基本情報技術者試験 合格<br>応用情報技術者試験 合格</p>
        <div class="flex items-center gap-tight flex-wrap mb-tight">
          <span class="badge">Go</span>
          <span class="badge">TypeScript</span>
        </div>
        <div class="flex flex-col gap-tight">
          <a href="https://x.com/isoshigicchi" target="_blank" rel="noopener noreferrer" class="text-sm w-fit">X @isoshigicchi</a>
          <a href="https://github.com/isoshigi" target="_blank" rel="noopener noreferrer" class="text-sm w-fit">GitHub isoshigi</a>
        </div>
      </div>
    </aside>
  </div>

  <footer class="bg-header border-t-4 border-accent mt-auto">
    <div class="container-page py-content flex flex-col sm:flex-row items-center justify-between gap-tight">
      <p class="text-faint">© 2026 いそしぎ</p>
      <div class="flex items-center gap-tight">
        <a href="https://x.com/isoshigicchi" target="_blank" rel="noopener noreferrer" class="text-sm text-header-fg transition-colors">X</a>
        <a href="https://github.com/isoshigi" target="_blank" rel="noopener noreferrer" class="text-sm text-header-fg transition-colors">GitHub</a>
      </div>
    </div>
  </footer>
</body>
</html>
