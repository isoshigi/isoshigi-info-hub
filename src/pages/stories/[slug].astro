---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentBody from '../../components/display/ContentBody.astro';
import SummaryCard from '../../components/display/SummaryCard.astro';
import { getCollection, render } from 'astro:content';
import { filterDrafts } from '../../lib/draftFilter';
import { resolveStoryFlow } from '../../lib/storyFlow';

export async function getStaticPaths() {
  const stories = await getCollection('stories', filterDrafts);
  return stories.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const resolvedFlow = await resolveStoryFlow(entry.data.storyFlow, entry.id);
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={`/img/stories/${entry.id}/og.png`}
  ogType="article"
>
  <ContentBody entry={entry} type="story">
    <div slot="before-content" class="stack-item">
      <h2 class="text-page-subtitle">ストーリーフロー</h2>
      <div class="content-list">
        {resolvedFlow.map((item) => (
          <SummaryCard
            type={item.type}
            title={item.entry.data.title}
            description={item.entry.data.description}
            publishedAt={item.entry.data.publishedAt}
            updatedAt={item.entry.data.updatedAt}
            tags={item.entry.data.tags}
            coverImage={item.entry.data.coverImage}
            href={item.href}
          />
        ))}
      </div>
    </div>
    <Content />
  </ContentBody>
</BaseLayout>
