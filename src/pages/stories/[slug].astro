---
import ContentLayout from '../../layouts/ContentLayout.astro';
import SummaryCard from '../../components/ui/SummaryCard.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { filterDrafts } from '../../lib/draftFilter';
import type { ContentType } from '../../lib/types';

export async function getStaticPaths() {
  const stories = await getCollection('stories', filterDrafts);
  return stories.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

type StoryCollection = 'articles' | 'slides' | 'stories';
type StoryEntry = CollectionEntry<'articles'> | CollectionEntry<'slides'> | CollectionEntry<'stories'>;

const allArticles = await getCollection('articles', filterDrafts);
const allSlides = await getCollection('slides', filterDrafts);
const allStories = await getCollection('stories', filterDrafts);
const entryMap: Record<StoryCollection, Record<string, StoryEntry>> = {
  articles: Object.fromEntries(allArticles.map((e) => [e.id, e])),
  slides: Object.fromEntries(allSlides.map((e) => [e.id, e])),
  stories: Object.fromEntries(allStories.map((e) => [e.id, e])),
};

const resolvedFlow = entry.data.storyFlow
  .map((item) => {
    const refEntry = entryMap[item.collection]?.[item.slug];
    if (!refEntry) {
      console.warn(`storyFlow: ${item.collection}/${item.slug} not found in story "${entry.id}"`);
      return null;
    }
    const type: ContentType = item.collection === 'slides'
      ? 'slide'
      : item.collection === 'stories'
        ? 'story'
        : 'article';
    return {
      ...item,
      type,
      entry: refEntry,
      href: `/${item.collection}/${item.slug}`,
    };
  })
  .filter((item): item is NonNullable<typeof item> => item !== null);
---

<ContentLayout entry={entry} type="story">
  <div slot="before-content" class="stack-item">
    <h2 class="text-lg font-bold text-text">ストーリーフロー</h2>
    <div class="content-list">
      {resolvedFlow.map((item) => (
        <SummaryCard
          type={item.type}
          title={item.entry.data.title}
          description={item.entry.data.description}
          publishedAt={item.entry.data.publishedAt}
          updatedAt={item.entry.data.updatedAt}
          tags={item.entry.data.tags}
          coverImage={item.entry.data.coverImage}
          href={item.href}
        />
      ))}
    </div>
  </div>
  <Content />
</ContentLayout>
