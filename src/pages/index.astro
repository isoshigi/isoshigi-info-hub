---
import BaseLayout from '../layouts/BaseLayout.astro';
import SummaryCard from '../components/display/SummaryCard.astro';
import { getAllContents } from '../lib/contents';

const latestItems = (await getAllContents()).slice(0, 5);
---

<BaseLayout
  title="いそしぎ忘備録"
  description="検証結果や試行記録を整理し、小さな成果として蓄積していくアウトプット共有サイト。"
  ogImage="/img/og.png"
>
  <div class="stack-section">
    <section class="stack-content">
      <h1 class="text-page-title">いそしぎ忘備録</h1>
      <p class="text-text-muted leading-relaxed">
        検証結果や試行記録を整理し、小さな成果として蓄積していくアウトプット共有サイトです。
        完璧を待たず、気軽に出せる場所を目指しています。
      </p>
    </section>

    <section class="stack-content">
      <div class="flex items-center justify-between">
        <h2 class="text-page-subtitle">最新の記録</h2>
        <a href="/pages" class="text-sm font-medium">すべて見る →</a>
      </div>
      {latestItems.length === 0 ? (
        <p class="text-text-muted text-sm">コンテンツがまだありません。準備が整い次第、ここに表示されます。</p>
      ) : (
        <ul class="content-list">
          {latestItems.map(({ entry, type, href }) => (
            <li>
              <SummaryCard
                type={type}
                title={entry.data.title}
                description={entry.data.description}
                publishedAt={entry.data.publishedAt}
                updatedAt={entry.data.updatedAt}
                tags={entry.data.tags}
                coverImage={entry.data.coverImage}
                href={href}
              />
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</BaseLayout>
