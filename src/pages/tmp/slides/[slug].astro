---
import RenderLayout from '../../../layouts/RenderLayout.astro';
import { getCollection, render } from 'astro:content';
import { filterDrafts } from '../../../lib/draftFilter';

export async function getStaticPaths() {
  const slides = await getCollection('slides', filterDrafts);
  return slides.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<RenderLayout>
  <Content />
</RenderLayout>

<style is:global>
  body { counter-reset: slide-page; }
</style>
