---
import RenderLayout from '../../layouts/RenderLayout.astro';
import OGImageCard from '../../components/render/OGImageCard.astro';
import { getAllContents } from '../../lib/contents';

const items = await getAllContents();
---

<RenderLayout>
  <div class="flex flex-col gap-10 p-10 bg-slate-400">
    <div id="og-home" class="w-[var(--render-og-width)] h-[var(--render-og-height)] shrink-0 shadow-xl">
      <OGImageCard
        title="いそしぎ忘備録"
        description="検証結果や試行記録を「物語として完成させ」、小さな成果として蓄積していくアウトプット共有サイト。"
        publishedAt={new Date('2026-01-01')}
        tags={[]}
      />
    </div>

    <div id="og-pages" class="w-[var(--render-og-width)] h-[var(--render-og-height)] shrink-0 shadow-xl">
      <OGImageCard
        title="すべての記録"
        description="技術記事、スライド、ストーリーなど、すべてのコンテンツを時系列で一覧表示しています。"
        publishedAt={new Date('2026-01-01')}
        tags={[]}
      />
    </div>

    {items.map(({ entry, type }) => (
      <div id={`og-${type}-${entry.id}`} class="w-[var(--render-og-width)] h-[var(--render-og-height)] shrink-0 shadow-xl">
        <OGImageCard
          type={type}
          title={entry.data.title}
          description={entry.data.description}
          publishedAt={entry.data.publishedAt}
          updatedAt={entry.data.updatedAt}
          tags={entry.data.tags}
        />
      </div>
    ))}
  </div>
</RenderLayout>
