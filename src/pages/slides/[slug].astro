---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SummaryCard from '../../components/ui/SummaryCard.astro';
import PageFooter from '../../components/ui/PageFooter.astro';
import { getCollection } from 'astro:content';
import { filterDrafts } from '../../lib/draftFilter';

export async function getStaticPaths() {
  const slides = await getCollection('slides', filterDrafts);
  return slides.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  ogImage={`/img/slides/${entry.id}/og.png`}
  ogType="article"
>
  <article class="stack-content">
    <SummaryCard
      type="slide"
      title={entry.data.title}
      description={entry.data.description}
      publishedAt={entry.data.publishedAt}
      updatedAt={entry.data.updatedAt}
      tags={entry.data.tags}
      coverImage={entry.data.coverImage}
    />

    <div class="aspect-video w-full border border-border overflow-hidden">
      <object data={`/pdf/slides/${entry.id}.pdf`} type="application/pdf" class="w-full h-full">
        <p class="text-text-muted text-sm p-4">
          PDFを表示できません。<a href={`/pdf/slides/${entry.id}.pdf`} class="text-accent underline">こちらからダウンロード</a>してください。
        </p>
      </object>
    </div>

    <PageFooter />
  </article>
</BaseLayout>
