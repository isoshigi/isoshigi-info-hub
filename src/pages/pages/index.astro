---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SummaryCard from '../../components/SummaryCard.astro';
import { getAllContents } from '../../lib/contents';

const allItems = await getAllContents();
---

<BaseLayout
  title="すべての記録"
  description="技術記事、調べ物、スライド、ストーリーなど、すべてのアウトプットを時系列で一覧表示しています。"
  ogImage="/img/pages/og.png"
>
  <div class="stack-content">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold text-text">すべての記録</h1>
      <span class="text-sm text-text-muted">{allItems.length} 件</span>
    </div>

    {allItems.length === 0 ? (
      <p class="text-text-muted">コンテンツがまだありません。</p>
    ) : (
      <ul class="content-list">
        {allItems.map(({ entry, type, href }) => (
          <li>
            <SummaryCard
              type={type}
              title={entry.data.title}
              description={entry.data.description}
              publishedAt={entry.data.publishedAt}
              updatedAt={entry.data.updatedAt}
              tags={entry.data.tags}
              coverImage={entry.data.coverImage}
              href={href}
            />
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
