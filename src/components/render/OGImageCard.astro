---
import { typeLabels } from '../../lib/typeLabels';
import { formatDate } from '../../lib/formatDate';
import type { ContentType } from '../../lib/types';

export interface Props {
  type?: ContentType;
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
}

const { type, title, description, publishedAt, updatedAt, tags } = Astro.props;
---

<div
  class="w-[var(--render-og-width)] h-[var(--render-og-height)] p-12
         bg-surface text-text border-l-4 border-l-accent
         flex flex-col justify-between"
>
  <div class="flex flex-col gap-section">
    <div class="flex items-center gap-item">
      {type && (
        <span class="badge text-xl py-tight px-content text-accent rounded">
          {typeLabels[type]}
        </span>
      )}
      <time class="text-lg text-text-muted" datetime={publishedAt.toISOString()}>
        {formatDate(publishedAt)}
        {updatedAt && updatedAt.getTime() !== publishedAt.getTime() && (
          <span>（更新: {formatDate(updatedAt)}）</span>
        )}
      </time>
    </div>

    <h1 class="text-5xl font-bold leading-tight text-text line-clamp-2">{title}</h1>
    <p class="text-2xl leading-normal text-text-muted line-clamp-3">{description}</p>
  </div>

  <div class="flex items-end justify-between gap-item mt-section">
    {tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-item">
        {tags.map((tag) => (
          <span class="badge text-lg font-medium py-[6px] px-item">{tag}</span>
        ))}
      </div>
    )}
    <div class="text-xl font-bold text-text-muted ml-auto shrink-0">isoshigi.dev</div>
  </div>
</div>
